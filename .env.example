# Market data store. Use the existing Supabase project and anon key only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional local company chat.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8080
WEB_FETCH_TOP_N=9

# Optional local earnings commentary generation.
EARNINGS_COMMENTARY_OLLAMA_ENABLED=false
EARNINGS_COMMENTARY_OLLAMA_TIMEOUT_MS=120000
EARNINGS_COMMENTARY_PIPELINE_TIMEOUT_MS=180000
EARNINGS_COMMENTARY_QNA_CONCURRENCY=2

# Optional production Basic Auth middleware.
SITE_USERNAME=dale
SITE_PASSWORD=
